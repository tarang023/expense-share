# ... (Keep your existing Maven build steps the same) ...

# Stage 2: Runtime
FROM eclipse-temurin:17-jre
WORKDIR /app

RUN useradd --system --user-group appuser
USER appuser
COPY --from=build --chown=appuser:appuser /app/target/*.jar app.jar

# Expose Vercel's default port
EXPOSE 80

# Pass the $PORT environment variable directly into Spring Boot
ENTRYPOINT ["sh", "-c", "java -Djava.net.preferIPv4Stack=true -Dserver.port=${PORT:=80} -jar app.jar"]